FROM rust:1-slim as builder

# Dépendances nécessaires pour compiler du C vers wasm32
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    lld \
    llvm \
    binaryen \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Configurer Clang comme compilateur C/C++ par défaut
ENV CC=clang
ENV CXX=clang++

# Ajout de la cible WASM
RUN rustup target add wasm32-unknown-unknown

# Install Trunk
RUN cargo install --locked trunk

WORKDIR /app

# Copy all project files into the build container
COPY Cargo.toml Cargo.lock ./
COPY index.html ./
COPY assets ./assets
COPY style ./style
COPY src ./src

# Single production build step
RUN trunk build --release

# Production stage using Nginx
FROM nginx:alpine as prod

EXPOSE 80

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/ /usr/share/nginx/html